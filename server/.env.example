# DevTrack Backend API Environment Configuration

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String
# Local dev: mongodb://127.0.0.1:27017/devtrack (DevTrack auto-falls back to MongoMemoryServer if offline)
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devtrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/devtrack

# JWT Authentication Secret (Use a strong random 32+ character key in production)
JWT_SECRET=your_jwt_secret_key_replace_in_production_32_characters_minimum

# Token Lifetime
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS & Cookies (comma-separated for multiple domains)
# Local: http://localhost:5173
# Production (Vercel): https://your-project.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173

# Optional: GitHub Personal Access Token
# If left blank, DevTrack performs unauthenticated public REST calls (60 requests/hour limit)
GITHUB_TOKEN=
